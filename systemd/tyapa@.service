[Unit]
Description=Tyapa %i service
PartOf=tyapa.target
After=network-online.target
Wants=network-online.target
# stop retrying after 10 crashes in 5 minutes instead of looping forever
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=pi
SupplementaryGroups=audio dialout
WorkingDirectory=/home/pi/robot-tyapa/services/%i
EnvironmentFile=-/home/pi/robot-tyapa/services/%i/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/robot-tyapa/services/%i/.venv/bin/python -m tyapa_%i
Restart=always
RestartSec=5

[Install]
WantedBy=tyapa.target
